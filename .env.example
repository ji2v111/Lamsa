# انسخ هذا الملف باسم .env وعبّي القيم — لا ترفع .env نفسه لأي مكان عام

# رابط قاعدة البيانات. محليًا اتركه فارغًا وراح يستخدم SQLite تلقائيًا.
# على الاستضافة الحقيقية، هذا رابط Postgres من Supabase (Settings -> Database -> Connection string -> URI)
DATABASE_URL=

# رابط موقعك بعد رفعه على Render (بدون / بالنهاية). محليًا اتركه كما هو.
BASE_URL=http://127.0.0.1:8000

# كلمة مرور لوحة التحكم (غيّرها لشي قوي قبل الرفع الحقيقي)
ADMIN_PASSWORD=change-me

# مفتاح سري لتشفير جلسة تسجيل الدخول — أي نص عشوائي طويل
SESSION_SECRET=change-this-to-a-long-random-string

# توكن بوت تيليجرام (اختياري بالبداية — التنبيهات تشتغل تلقائيًا بمجرد ما تعبيه)
TELEGRAM_BOT_TOKEN=
